COP_DB_PATH=/data/cop.db
COP_LOG_LEVEL=INFO

# Optional API key for all write endpoints.
COP_API_KEY=change-me

# Production hardening
ENABLE_DOCS=false
TRUSTED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=
MAX_META_BYTES=8192

# Video and simulation
RTSP_URL=
FPV_SIM_ENABLED=true

# External feed
LIVE_FEED_URL=
LIVE_FEED_INTERVAL=5
LIVE_FEED_TIMEOUT_S=8

# TAK bridge (set TAK_HOST to enable)
TAK_HOST=
TAK_PORT=8087
TAK_TLS=false
TAK_TLS_INSECURE_SKIP_VERIFY=false
TAK_CERT=
TAK_KEY=
TAK_CA=
TAK_CALLSIGN=COP-LITE
TAK_PUSH_INTERVAL=30

# zenoh bridge (core service)
ZENOH_CONNECT=tcp/127.0.0.1:7447
ZENOH_PUB_KEYEXPR=cop/tracks
ZENOH_SUB_KEYEXPR=cop/tracks
ZENOH_PUBLISH=true
ZENOH_SUBSCRIBE=true
